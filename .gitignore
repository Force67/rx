build/
# Agent worktrees: a full second checkout of this repo lives under here, so
# without this a `git add -A` commits a copy of the tree into itself.
.claude/
scratch/
out/
.cache/
compile_commands.json
__pycache__/
*.pyc
.vs/
.idea/
.direnv/
result
assets/
!runtime/feature_gym/assets/
!runtime/feature_gym/assets/**
!engine/assets/
!engine/assets/**
third_party/FidelityFX-SDK/
third_party/JoltPhysics/
third_party/DLSS/
third_party/NRD/
third_party/NRD-MathLib/
third_party/NRD-ShaderMake/
third_party/tinyusdz/
vkd3d-proton.cache*

# .rxp archives are all build products - the engine's own are packed into the
# build directory, and the editor's Bake World writes one beside its .rxscene.
# None is tracked, and committing one would churn a binary on every bake.
*.rxp
# Editor save temporaries: staging files and the numbered backups DoSave leaves.
*.editor-stage
*.editor-backup
*.editor-backup.*
