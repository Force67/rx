rxscene 1

# Low street frontage: big ground-floor glazing under a fascia band, one storey
# of flats above, a parapet. This is the prefab that carries the street rather
# than the skyline, so all its detail is in the two metres either side of eye
# height.

entity
Name.value = "Shop glazing"
Shape.kind = "box"
Shape.size = 5 1.8 3.4
Surface.base_color = 1 1 1
Surface.roughness = 0.86
Pattern.kind = "grid"
Pattern.scale = 4 1
Pattern.line_width = 0.12
Pattern.color_a = 0.26 0.2 0.15
Pattern.color_b = 0.30 0.34 0.38
Pattern.relief = 0.022
Pattern.roughness_a = 0.9
Pattern.roughness_b = 0.06

# The fascia is where a shop's name goes, so it is the one band with a colour of
# its own; without it the glazing runs straight into the flats above and the row
# reads as a two-storey window.
entity
Name.value = "Shop fascia"
Transform.position = 0 2.15 0
Shape.kind = "box"
Shape.size = 5.1 0.35 3.5
Surface.base_color = 0.36 0.2 0.14
Surface.roughness = 0.7

entity
Name.value = "Shop upper"
Transform.position = 0 4 0
Shape.kind = "box"
Shape.size = 5 1.5 3.4
Surface.base_color = 1 1 1
Surface.roughness = 0.93
Pattern.kind = "grid"
Pattern.scale = 4 1
Pattern.line_width = 0.4
Pattern.color_a = 0.42 0.4 0.37
Pattern.color_b = 0.12 0.14 0.17
Pattern.relief = 0.03
Pattern.roughness_a = 0.94
Pattern.roughness_b = 0.12

entity
Name.value = "Shop parapet"
Transform.position = 0 5.7 0
Shape.kind = "box"
Shape.size = 5.1 0.25 3.5
Surface.base_color = 0.38 0.36 0.34
Surface.roughness = 0.94

# An awning over the pavement, which is the only thing here that reaches out
# past the building line and so the only one that casts a shadow onto the
# footway rather than onto itself.
entity
Name.value = "Shop awning"
Transform.position = 0 0.5 4.1
Shape.kind = "box"
Shape.size = 4.4 0.08 0.8
Surface.base_color = 0.32 0.14 0.12
Surface.roughness = 0.85
