# --- fill light --------------------------------------------------------------
# The lamps light the kerbs; these keep the far end of the avenue and the tower
# faces from going to black, which the sun alone does not reach at this hour.

entity
Name.value = "Avenue fill"
Transform.position = 0 34 -26
Light.color = 0.72 0.79 1
Light.intensity = 26
Light.radius = 70

entity
Name.value = "Intersection fill"
