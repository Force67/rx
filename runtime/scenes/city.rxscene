# --- street lighting ---------------------------------------------------------
# Lamps down the west kerb, then the east. Each is one prefab instance carrying
# its own pole, arm, lit head and point light, so the rig is placed with the
# geometry rather than authored separately. A grid member is placed by its
# container and so cannot also be anchored, which is why this row still names a
# height: one number for sixteen lamps.

entity
Name.value = "West kerb lamps"
Transform.position = -10.2 4 40
Grid.count = 1 1 8
Grid.step = 0 0 -15
Grid.cell = "prefabs/city/streetlamp.rxscene"

