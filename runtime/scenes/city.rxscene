rxscene 1

# A demo city, authored entirely as text through the .rxscene system. No C++,
# no imported art: every building is a prefab from prefabs/city/, every facade
# is a procedural pattern, every material is a named preset or inline PBR.
#
# The street grid stays square on purpose. A city reads as a city because its
# blocks are orthogonal; what is turned off-axis is the traffic and the clutter,
# which is what tells you the place is lived in rather than laid out.
#
#   rx --validate runtime/scenes/city.rxscene
#   rx --scene runtime/scenes/city.rxscene --headless --shot out.png \
#      --shot-frames 20 --width 1280 --height 720

# Street-level at the intersection, looking north up the avenue. Low and off the
# centre line so the towers rake and the cross street opens on the right.
entity
Name.value = "Camera"
Transform.position = 2.6 6.4 56
Camera.target = -0.5 13 -34
Camera.fov_degrees = 55

# --- ground and roads --------------------------------------------------------

entity
Name.value = "Ground"
Transform.position = 0 0 0
Shape.kind = "plane"
Shape.size = 150 0 150
Surface.base_color = 0.20 0.20 0.21
Surface.roughness = 0.94
Pattern.kind = "grid"
Pattern.scale = 60
Pattern.line_width = 0.06
Pattern.color_a = 0.30 0.30 0.31
Pattern.color_b = 0.19 0.19 0.20
Pattern.relief = 0.01
Pattern.roughness_a = 0.92
Pattern.roughness_b = 0.95

# Asphalt sits a hair above the paving so it wins the depth test cleanly.
entity
Name.value = "Avenue"
Transform.position = 0 0.02 0
