# --- the west terrace --------------------------------------------------------
# Turned +90 so each frontage faces the carriageway (+90 about y takes a
# prefab's +z face onto +x). Every one of these is Anchor.offset = x 0 z: the
# two numbers that are a decision, with the third derived. The Stretches stay
# inside about 0.85..1.25, because a stretch scales the facade's window cells
# along with the building and a big one reads as a different building rather
# than as a taller one.

entity
Name.value = "W shops near"
Rotation.euler = 0 90 0
Anchor.target = "Ground"
Anchor.mode = "on"
Anchor.offset = -19 0 40
Stretch.scale = 1 1.05 1.1
Prefab.path = "prefabs/city/shop_row.rxscene"

entity
Name.value = "W brick near"
Rotation.euler = 0 90 0
Anchor.target = "Ground"
Anchor.mode = "on"
