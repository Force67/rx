# --- street clutter ----------------------------------------------------------
# The only things in the scene off the grid. A city is orthogonal; the stuff
# people leave in it is not. All of it anchored onto the pavement rather than
# the road, so it rides the kerb height without naming it.

entity
Name.value = "Skip"
Rotation.euler = 0 -12 0
Anchor.target = "West sidewalk"
Anchor.mode = "on"
Anchor.offset = -0.4 0 21
Shape.kind = "box"
Shape.size = 1.5 0.9 0.9
Prefab.path = "materials/steel.rxscene"

entity
