# --- street clutter ----------------------------------------------------------
# The only things in the scene that are off the grid. A city is orthogonal; the
# stuff people leave in it is not.

entity
Name.value = "Skip"
Transform.position = -11.6 0.9 21
Rotation.euler = 0 -12 0
Shape.kind = "box"
Shape.size = 1.5 0.9 0.9
Prefab.path = "materials/steel.rxscene"

entity
Name.value = "Crate by skip"
Rotation.euler = 0 34 0
Anchor.target = "Skip"
Anchor.mode = "on"
Shape.kind = "box"
Shape.size = 0.45 0.45 0.45
Prefab.path = "materials/wood_planks.rxscene"

# The kiosk is the one thing at the near kerb big enough to read, so it carries
# a lit sign rather than sitting there as an unlit block. The sign is anchored
# on its front face, so turning the kiosk turns the sign with it.
entity
Name.value = "Kiosk"
Transform.position = 11.8 1.3 6
Rotation.euler = 0 -21 0
Shape.kind = "box"
Shape.size = 1.1 1.3 1.1
Prefab.path = "materials/plaster_white.rxscene"

entity
Name.value = "Kiosk sign"
Anchor.target = "Kiosk"
Anchor.mode = "front"
Rotation.euler = 0 -21 0
Shape.kind = "box"
Shape.size = 0.85 0.34 0.06
Surface.base_color = 0.9 0.97 1
Surface.emissive = 2.2 3.4 4.2
Surface.roughness = 0.35

entity
Name.value = "Kiosk glow"
Transform.position = 11.8 1.9 7.6
Light.color = 0.6 0.86 1
Light.intensity = 5
Light.radius = 8

