# --- roofline ----------------------------------------------------------------
# Plant rooms and tanks, anchored on the towers they sit on. An anchor centres
# on its target, which is what a penthouse wants anyway, and it means none of
# these heights is written down: retune a tower and its roof follows.

entity
Name.value = "E glass plant"
Anchor.target = "E glass"
Anchor.mode = "on"
Rotation.euler = 0 6 0
Shape.kind = "box"
Shape.size = 2.2 1.1 2.2
Prefab.path = "materials/concrete.rxscene"

