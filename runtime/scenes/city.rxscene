# --- fill --------------------------------------------------------------------
# The sun lights one terrace and the lamps light the kerbs; this keeps the shaded
# terrace off black without flattening it. One light, high and cool, against a
# warm low key: raising Sun.ambient instead would lift the whole image evenly and
# take the modelling out of it.

entity
Name.value = "Avenue fill"
Transform.position = -14 30 -18
Light.color = 0.62 0.72 1
Light.intensity = 22
Light.radius = 80
