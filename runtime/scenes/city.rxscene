rxscene 1

# A demo city, authored entirely as text. No C++, no imported art: every
# building is a prefab from prefabs/city/, every facade is a procedural pattern,
# every material is a named preset or inline PBR.
#
# Three things carry this scene, and all three are properties of the format
# rather than of the layout:
#
#   The light is AUTHORED. Sun and Atmosphere below fix a low evening sun and
#   the haze it rakes through, instead of taking whatever hour the world clock
#   was at. The sun is off to +x, so the west terrace is lit and the east one is
#   in its own shade - a street reads as a street largely because its two sides
#   are not the same brightness.
#
#   No building writes down its height. Each is anchored onto the ground with an
#   Anchor.offset saying where on it, so the y is derived from the prefab's own
#   geometry. Retune a prefab, or a Stretch, and every instance follows; the old
#   version of this file carried 24 hand-multiplied half-heights, every one of
#   which silently sank its building the moment either changed.
#
#   Every building is SEVERAL masses - podium, shaft, crown - and an instance's
#   Stretch reaches all of them (see SceneStretch). That is what makes the
#   skyline a skyline: with a Stretch that only reached the root, the only shape
#   that survived being proportioned was a single box, so every silhouette was a
#   rectangle of a different height.
#
# The street grid stays square on purpose. A city reads as a city because its
# blocks are orthogonal; what is turned off-axis is the traffic and the clutter,
# which is what tells you the place is lived in rather than laid out.
#
#   rx --validate runtime/scenes/city.rxscene
#   rx --scene runtime/scenes/city.rxscene --headless --shot out.png \
#      --shot-frames 20 --width 1280 --height 720

# Street level, off the centre line so the towers rake and the cross street
# opens on the right. Low, because the thing worth seeing here is the way the
# terraces converge, and that only happens from eye height.
entity
Name.value = "Camera"
Transform.position = 4.2 4.6 54
Camera.target = -2 14 -46
Camera.fov_degrees = 52

# --- light and air -----------------------------------------------------------
# A low sun off to +x: long shadows across the carriageway, one terrace lit and
# one in shade. Elevation is what decides how much of the scene is in shadow at
# all, so it is the single number here worth moving first when the render reads
# flat.
entity
Name.value = "Evening"
Sun.elevation = 12
Sun.azimuth = 42
Sun.color = 1 0.74 0.5
Sun.intensity = 6.5
Sun.ambient = 0.055
# Enough haze to separate the near terrace from the far one and to give the
# lamps something to glow into. Past about 0.05 the froxel volume starts to band
# at grazing angles on a large ground plane, which is the practical ceiling.
Atmosphere.density = 0.009
Atmosphere.start_distance = 10
Atmosphere.exposure = 0.9

