rxscene 1

# Unglazed terracotta: flower pots, roof tiles, floor pavers. Matte, because the
# clay is fired without a glaze; the fine noise is the porous surface and only
# modulates the fired colour, which is why the pattern colours sit near 1.

entity
Surface.base_color = 0.4 0.15 0.075
Surface.roughness = 0.9
Pattern.kind = "noise"
Pattern.scale = 12 12
Pattern.color_a = 0.6 0.58 0.55
Pattern.color_b = 1 1 1
Pattern.relief = 0.02
Pattern.resolution = 512
