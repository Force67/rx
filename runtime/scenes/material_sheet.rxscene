rxscene 1

# Material contact sheet: 24 surfaces on one neutral floor, so a pass over a
# batch of materials costs one render instead of 24. Cells are named A1..D6,
# reading left to right, back row to front:
#
#   A  roughness sweep, 0 to 1, plain dielectric
#   B  metals: gold, copper, brushed (anisotropic) steel, blasted aluminium,
#      chrome, iridescent chrome
#   C  dielectric lobes: clearcoat, sheen, subsurface, the soft/rim/back fills,
#      transmission, env_reflect
#   D  the procedural patterns: checker, grid, brick, gradient, noise, noise at
#      deep relief
#
# No cell carries a coordinate or a shape: the "Sheet" entity below is a 6 x 4
# grid and each cell is a member of it, so a cell says only the material it
# exists to show. Members take cells in the order this file declares them, which
# is why the rows read straight down the file. To move the whole sheet, move
# Sheet; to respace it, change Grid.step; to sweep your own batch, replace a
# row's six blocks and re-render:
#   rx --scene runtime/scenes/material_sheet.rxscene --headless \
#      --shot sheet.png --shot-frames 20 --width 1280 --height 960
#
# Nothing here is special-cased; it is an ordinary scene, so --dump-schema is
# still the reference for what a block may say.

entity
Name.value = "Camera"
Transform.position = 0 7.3 6.3
Camera.target = 0 0.45 -2.3
Camera.fov_degrees = 40

# Neutral floor. Mid grey and fully rough so it neither tints the surfaces nor
# competes with them for the eye.
entity
Name.value = "Floor"
Shape.kind = "plane"
Shape.size = 12 0 12
Surface.base_color = 0.35 0.35 0.35
Surface.roughness = 1

# A soft fill from the camera side, so the shadow side of every sphere still
# carries some shape on top of the sun.
entity
Name.value = "Fill"
Transform.position = 0 5 6
Light.color = 1 0.95 0.9
Light.intensity = 10
Light.radius = 22

# The sheet itself: where cell A1 sits, how far apart the cells are, and what
# every cell is made of. Its Transform is cell 0 0 0, and y is the cell sphere's
# radius, which is what stands the row on the floor.
entity
Name.value = "Sheet"
Transform.position = -3.75 0.55 -4.5
Grid.count = 6 1 4
Grid.step = 1.5 0 1.5
Grid.cell = "prefabs/sheet_cell.rxscene"

# --- A: roughness sweep, plain dielectric ---

entity
Name.value = "A1 roughness 0"
Grid.of = "Sheet"
Surface.base_color = 0.18 0.18 0.19
Surface.roughness = 0

entity
Name.value = "A2 roughness 0.2"
Grid.of = "Sheet"
Surface.base_color = 0.18 0.18 0.19
Surface.roughness = 0.2

entity
Name.value = "A3 roughness 0.4"
Grid.of = "Sheet"
Surface.base_color = 0.18 0.18 0.19
Surface.roughness = 0.4

entity
Name.value = "A4 roughness 0.6"
Grid.of = "Sheet"
Surface.base_color = 0.18 0.18 0.19
Surface.roughness = 0.6

entity
Name.value = "A5 roughness 0.8"
Grid.of = "Sheet"
Surface.base_color = 0.18 0.18 0.19
Surface.roughness = 0.8

entity
Name.value = "A6 roughness 1"
Grid.of = "Sheet"
Surface.base_color = 0.18 0.18 0.19
Surface.roughness = 1

# --- B: metals ---

entity
Name.value = "B1 gold"
Grid.of = "Sheet"
Surface.base_color = 1 0.77 0.34
Surface.roughness = 0.25
Surface.metallic = 1

entity
Name.value = "B2 copper"
Grid.of = "Sheet"
Surface.base_color = 0.95 0.64 0.54
Surface.roughness = 0.4
Surface.metallic = 1

entity
Name.value = "B3 brushed steel"
Grid.of = "Sheet"
Surface.base_color = 0.9 0.9 0.92
Surface.roughness = 0.3
Surface.metallic = 1
Surface.anisotropy = 0.9

entity
Name.value = "B4 blasted aluminium"
Grid.of = "Sheet"
Surface.base_color = 0.91 0.92 0.92
Surface.roughness = 0.65
Surface.metallic = 1

entity
Name.value = "B5 chrome"
Grid.of = "Sheet"
Surface.base_color = 0.95 0.95 0.95
Surface.roughness = 0.05
Surface.metallic = 1

entity
Name.value = "B6 iridescent chrome"
Grid.of = "Sheet"
Surface.base_color = 0.9 0.9 0.9
Surface.roughness = 0.3
Surface.metallic = 1
Surface.iridescence = 1
Surface.iridescence_thickness = 520

