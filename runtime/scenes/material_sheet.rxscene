rxscene 1

# Material contact sheet: 24 surfaces on one neutral floor, so a pass over a
# batch of materials costs one render instead of 24. Cells are named A1..D6,
# reading left to right, back row to front:
#
#   A  roughness sweep, 0 to 1, plain dielectric
#   B  metals: gold, copper, brushed (anisotropic) steel, blasted aluminium,
#      chrome, iridescent chrome
#   C  dielectric lobes: clearcoat, sheen, subsurface, the soft/rim/back fills,
#      transmission, env_reflect
#   D  the procedural patterns: checker, grid, brick, gradient, noise, noise at
#      deep relief
#
# To sweep your own batch, replace a row's six blocks and re-render:
#   rx --scene runtime/scenes/material_sheet.rxscene --headless \
#      --shot sheet.png --shot-frames 20 --width 1280 --height 960
#
# Nothing here is special-cased; it is an ordinary scene, so --dump-schema is
# still the reference for what a block may say.

entity
Name.value = "Camera"
Transform.position = 0 7.3 6.3
Camera.target = 0 0.45 -2.3
Camera.fov_degrees = 40

# Neutral floor. Mid grey and fully rough so it neither tints the surfaces nor
# competes with them for the eye.
entity
Name.value = "Floor"
Shape.kind = "plane"
Shape.size = 12 0 12
Surface.base_color = 0.35 0.35 0.35
Surface.roughness = 1

# A soft fill from the camera side, so the shadow side of every sphere still
# carries some shape on top of the sun.
entity
Name.value = "Fill"
Transform.position = 0 5 6
Light.color = 1 0.95 0.9
Light.intensity = 10
Light.radius = 22

# A1  roughness 0
entity
Name.value = "A1 roughness 0"
Transform.position = -3.75 0.55 -4.5
Shape.kind = "sphere"
Shape.size = 0.55 0 0
Surface.base_color = 0.18 0.18 0.19
Surface.roughness = 0

# A2  roughness 0.2
