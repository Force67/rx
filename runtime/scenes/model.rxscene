rxscene 1

# Real art assets in a text scene: Model names a .gltf/.glb file and the
# geometry, materials and textures inside it are what render. Nothing here is
# procedural except the ground the models stand on.
#
# Paths are relative to the working directory, so run this from the repo root:
#   rx --scene runtime/scenes/model.rxscene --headless --shot out.png \
#      --shot-frames 20 --width 960 --height 540
#
# `rx --dump-schema` prints every component and prop this file may use.

entity
Name.value = "Camera"
Transform.position = 0 1.5 4.2
Camera.target = 0 0.55 0
Camera.fov_degrees = 45

entity
Name.value = "Ground"
Shape.kind = "plane"
Shape.size = 6 0 6
Surface.base_color = 0.35 0.36 0.38
Surface.roughness = 0.85

# The whole file: both of its nodes are placed, keeping the layout the file
# describes, and this Transform moves the pair as one. The left box takes its
# base colour from the png embedded in the .gltf, the right one from its
# material's base colour factor.
entity
Name.value = "Two boxes"
Transform.position = -1.1 0 0
Model.path = "test/data/TwoBoxes.gltf"

# One mesh out of the same file, placed at this Transform instead of where the
# file's node put it. The file is imported once and shared with the entity
# above.
entity
Name.value = "Cobalt box on its own"
Transform.position = 1.5 0.35 0.6
Transform.scale = 0.8
Model.path = "test/data/TwoBoxes.gltf#mesh1"

# A second file, to show the placement is per-file. Its node scales the cube by
# 100, so the authored scale brings it back to something that fits the frame.
entity
Name.value = "Morph cube"
Transform.position = 1.4 0.45 -0.9
Transform.scale = 0.45
Model.path = "test/data/AnimatedMorphCube.glb"

entity
Name.value = "Key light"
Transform.position = -0.5 3 2.5
Light.color = 1 0.95 0.88
Light.intensity = 14
Light.radius = 10
