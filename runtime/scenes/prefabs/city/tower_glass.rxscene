Pattern.line_width = 0.14
Pattern.color_a = 0.32 0.34 0.36
Pattern.color_b = 0.10 0.15 0.20
Pattern.relief = 0.012
Pattern.roughness_a = 0.85
Pattern.roughness_b = 0.08
