rxscene 1

# A streetlamp: pole, arm and a lit head. Multi-entity, so the head and arm ride
# along as Transient children of whatever instances the pole, and one Transform
# on the instance moves the lot. The head carries its own Light, so placing
# lamps down a street places the street lighting with them.
#
# The pole is centred on the entity origin, so an instance sits it on the ground
# by placing it at its own half height (4).

entity
Name.value = "Lamp pole"
Shape.kind = "cylinder"
Shape.size = 0.11 4 0
Surface.base_color = 0.17 0.18 0.19
Surface.roughness = 0.45
Surface.metallic = 0.9

entity
Name.value = "Lamp arm"
Transform.position = 0.7 3.9 0
Shape.kind = "box"
Shape.size = 0.7 0.07 0.07
Surface.base_color = 0.17 0.18 0.19
Surface.roughness = 0.45
Surface.metallic = 0.9

entity
Name.value = "Lamp head"
Transform.position = 1.35 3.7 0
Shape.kind = "capsule"
Shape.size = 0.22 0.1 0
Surface.base_color = 1 0.93 0.78
Surface.emissive = 0.85 0.68 0.42
Surface.roughness = 0.3

entity
Name.value = "Lamp light"
Transform.position = 1.35 3.4 0
Light.color = 1 0.86 0.62
Light.intensity = 7
Light.radius = 14
