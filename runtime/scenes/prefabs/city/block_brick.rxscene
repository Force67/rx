rxscene 1

# Mid-rise brick warehouse conversion. Brick courses at wall scale, punched
# sash windows on top of them is not expressible with one pattern, so the
# windows win: a blank brick box reads as a wall, not a building.
entity
Name.value = "Brick block"
Shape.kind = "box"
Shape.size = 6 7 5
Surface.base_color = 1 1 1
Surface.roughness = 0.95
Pattern.kind = "grid"
Pattern.scale = 5 5
Pattern.line_width = 0.34
Pattern.color_a = 0.30 0.10 0.07
Pattern.color_b = 0.13 0.14 0.15
Pattern.relief = 0.04
Pattern.roughness_a = 0.95
Pattern.roughness_b = 0.2
