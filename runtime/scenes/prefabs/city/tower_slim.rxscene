rxscene 1

# A narrow tower to break the skyline: two setbacks and a mast, so it tapers
# instead of stopping. Fewer, taller bays than the glass tower so it does not
# read as the same asset stretched, which is the failure a second tower prefab
# exists to avoid in the first place.

entity
Name.value = "Slim shaft"
Shape.kind = "box"
Shape.size = 3 16 3
Surface.base_color = 1 1 1
Surface.roughness = 0.88
Pattern.kind = "grid"
Pattern.scale = 2 11
Pattern.line_width = 0.18
Pattern.color_a = 0.28 0.27 0.26
Pattern.color_b = 0.14 0.17 0.19
Pattern.relief = 0.02
Pattern.roughness_a = 0.9
Pattern.roughness_b = 0.1

entity
Name.value = "Slim base"
Transform.position = 0 -18.5 0
Shape.kind = "box"
Shape.size = 3.6 2.5 3.6
Surface.base_color = 1 1 1
Surface.roughness = 0.9
Pattern.kind = "grid"
Pattern.scale = 3 1
Pattern.line_width = 0.12
Pattern.color_a = 0.24 0.23 0.22
Pattern.color_b = 0.15 0.19 0.24
Pattern.relief = 0.02
Pattern.roughness_a = 0.85
Pattern.roughness_b = 0.08

# Two setbacks rather than one: a single step reads as a lid, two read as a
# building that got narrower as it got taller.
entity
Name.value = "Slim setback"
Transform.position = 0 17.4 0
Shape.kind = "box"
Shape.size = 2.3 1.4 2.3
Surface.base_color = 0.3 0.3 0.3
Surface.roughness = 0.9

entity
Name.value = "Slim cap"
Transform.position = 0 19.6 0
Shape.kind = "box"
Shape.size = 1.5 0.8 1.5
Surface.base_color = 0.26 0.26 0.27
Surface.roughness = 0.88

entity
Name.value = "Slim mast"
Transform.position = 0 22.4 0
Shape.kind = "cylinder"
Shape.size = 0.1 2 0
Surface.base_color = 0.2 0.21 0.22
Surface.roughness = 0.45
Surface.metallic = 0.9

# The one lit thing this high up, so the tower still reads against a dark sky.
entity
Name.value = "Slim beacon"
Transform.position = 0 24.5 0
Shape.kind = "sphere"
Shape.size = 0.18 0 0
Surface.base_color = 1 0.4 0.35
Surface.emissive = 3.2 0.5 0.35
Surface.roughness = 0.4
